source 'https://rubygems.org'

# Jekyll 3.10 is what the github-pages gem used to build this site, so the theme's Sass and
# Liquid behave the same. The site is now built by .github/workflows/pages.yml.
gem 'jekyll', '~> 3.10'
gem 'kramdown-parser-gfm'
gem 'webrick', '~> 1.8'

group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
end
